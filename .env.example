# ICAM2 Configuration Example
# Copy this file to .env and adjust values for your environment

# ============================================================================
# Application Settings
# ============================================================================
APP_NAME="ICAM2 Video Analytics"
DEBUG=True
VERSION=0.1.0

# ============================================================================
# Database Configuration
# ============================================================================
DATABASE_URL=postgresql+asyncpg://icam2:icam2password@localhost/icam2
DB_ECHO=False  # Set to True for SQL query logging
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# ============================================================================
# Security
# ============================================================================
# Generate a secure key: openssl rand -hex 32
SECRET_KEY=your-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ============================================================================
# YOLO Detection Settings
# ============================================================================
# Model options: yolov8n.pt, yolov8s.pt, yolov8m.pt, yolov8l.pt, yolov8x.pt
# n=nano (fastest), s=small, m=medium, l=large, x=extra large (most accurate)
YOLO_MODEL=yolov8n.pt
YOLO_CONFIDENCE=0.5
YOLO_IOU_THRESHOLD=0.45
YOLO_INPUT_SIZE=640  # 640, 1280, etc.

# ============================================================================
# Face Recognition Settings
# ============================================================================
# Face detector options: retinaface, mtcnn, ssd, opencv, dlib
FACE_DETECTOR=retinaface
# Face model options: ArcFace, FaceNet, VGG-Face, OpenFace, DeepFace
FACE_MODEL=ArcFace
# Similarity threshold (0.0-1.0, lower = stricter)
FACE_SIMILARITY_THRESHOLD=0.6
# Minimum face size in pixels
FACE_MIN_SIZE=80

# ============================================================================
# Tracking Settings
# ============================================================================
# Tracker type: bytetrack, botsort
TRACKER_TYPE=bytetrack
# Maximum frames to keep lost tracks
MAX_LOST_FRAMES=30
# Minimum track length to consider valid
MIN_TRACK_LENGTH=3

# ============================================================================
# Video Processing Settings
# ============================================================================
# How many FPS to process (not video FPS, processing rate)
PROCESS_FPS=5
# Skip every N frames (1 = process all frames)
FRAME_SKIP=5
# Maximum resolution to process (will resize if larger)
MAX_FRAME_WIDTH=1280
MAX_FRAME_HEIGHT=720

# ============================================================================
# GPU Settings
# ============================================================================
# CUDA device: cuda:0, cuda:1, cpu
DEVICE=cuda:0
# Use TensorRT for optimization (requires conversion)
USE_TENSORRT=False
# Use FP16 (half precision) for faster inference
USE_FP16=False
# Batch size for processing multiple frames
BATCH_SIZE=4

# ============================================================================
# Performance Tuning
# ============================================================================
# Number of worker threads
WORKER_THREADS=4
# Queue size for frame buffer
FRAME_QUEUE_SIZE=10
# Enable caching of embeddings
ENABLE_EMBEDDING_CACHE=True
# Cache TTL in seconds
CACHE_TTL=300

# ============================================================================
# Camera Settings
# ============================================================================
# Default camera sources (comma-separated)
# Examples:
#   - USB webcam: 0, 1, 2
#   - RTSP: rtsp://admin:password@192.168.1.100:554/stream
#   - HTTP: http://192.168.1.100:8080/video
CAMERA_SOURCES=0

# Camera names (comma-separated, same order as sources)
CAMERA_NAMES=Main Camera

# Reconnection settings
CAMERA_RECONNECT_ATTEMPTS=5
CAMERA_RECONNECT_DELAY=5

# ============================================================================
# Attendance Tracking
# ============================================================================
# Time in seconds before marking as "away"
AWAY_TIMEOUT=300
# Minimum presence time to record (in seconds)
MIN_PRESENCE_TIME=60
# Working hours (24h format)
WORKING_HOURS_START=09:00
WORKING_HOURS_END=18:00

# ============================================================================
# Activity Analysis (Optional)
# ============================================================================
# Enable pose analysis
ENABLE_POSE_ANALYSIS=False
# Pose detection confidence
POSE_CONFIDENCE=0.5
# Activity classification thresholds
WORKING_THRESHOLD=0.7
IDLE_THRESHOLD=0.3

# ============================================================================
# Storage Settings
# ============================================================================
# Base directory for data
DATA_DIR=./data
# Directory for employee photos
EMPLOYEES_DIR=./data/employees
# Directory for recordings (if enabled)
RECORDINGS_DIR=./data/recordings
# Directory for model weights
WEIGHTS_DIR=./weights

# Save snapshots of detections
SAVE_SNAPSHOTS=False
# Snapshot directory
SNAPSHOTS_DIR=./data/snapshots

# ============================================================================
# Logging
# ============================================================================
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
# Log file path
LOG_FILE=./logs/icam2.log
# Max log file size (MB)
LOG_MAX_SIZE=10
# Number of backup log files
LOG_BACKUP_COUNT=5

# ============================================================================
# API Settings
# ============================================================================
API_HOST=0.0.0.0
API_PORT=8000
# Enable API documentation
API_DOCS_ENABLED=True
# CORS allowed origins (comma-separated, * for all)
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
# Max request size (MB)
MAX_REQUEST_SIZE=10

# ============================================================================
# WebSocket Settings
# ============================================================================
WS_HEARTBEAT_INTERVAL=30
WS_MAX_CONNECTIONS=100

# ============================================================================
# Redis (Optional, for caching and queues)
# ============================================================================
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=False

# ============================================================================
# Alternative: CompreFace Integration
# ============================================================================
# If using CompreFace instead of custom face recognition
USE_COMPREFACE=False
COMPREFACE_URL=http://localhost:8000
COMPREFACE_API_KEY=your-api-key-here

# ============================================================================
# Monitoring & Metrics
# ============================================================================
# Enable Prometheus metrics
ENABLE_METRICS=False
METRICS_PORT=9090

# ============================================================================
# Development Settings
# ============================================================================
# Auto reload on code changes
AUTO_RELOAD=True
# Show detailed errors
SHOW_ERROR_DETAILS=True
# Enable profiling
ENABLE_PROFILING=False

# ============================================================================
# Feature Flags
# ============================================================================
FEATURE_FACE_RECOGNITION=True
FEATURE_POSE_ANALYSIS=False
FEATURE_ACTIVITY_CLASSIFICATION=False
FEATURE_MULTI_CAMERA=False
FEATURE_RECORDING=False
FEATURE_NOTIFICATIONS=False

# ============================================================================
# Notification Settings (Optional)
# ============================================================================
NOTIFICATION_ENABLED=False
# Email settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
NOTIFICATION_EMAIL=admin@example.com

# Telegram settings (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ============================================================================
# Preset Configurations
# ============================================================================
# Use one of the presets below by setting PRESET variable
# Options: development, production, low_spec, high_performance
PRESET=

# Preset: development (for laptops/testing)
# YOLO_MODEL=yolov8n.pt
# PROCESS_FPS=3
# BATCH_SIZE=1
# ENABLE_POSE_ANALYSIS=False

# Preset: production (balanced)
# YOLO_MODEL=yolov8s.pt
# PROCESS_FPS=5
# BATCH_SIZE=4
# USE_FP16=True

# Preset: low_spec (for GPU <8GB)
# YOLO_MODEL=yolov8n.pt
# PROCESS_FPS=3
# BATCH_SIZE=1
# MAX_FRAME_WIDTH=640
# MAX_FRAME_HEIGHT=480

# Preset: high_performance (for GPU 16GB+)
# YOLO_MODEL=yolov8m.pt
# PROCESS_FPS=10
# BATCH_SIZE=8
# USE_TENSORRT=True
# USE_FP16=True
